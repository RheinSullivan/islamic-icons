{
  "name": "islamic-icons",
  "version": "0.1.0",
  "description": "A framework-agnostic Islamic SVG and WebP icon library for the modern web.",
  "author": {
    "name": "Islamic Icons Community",
    "email": "icons@vyagra.dev",
    "url": "https://github.com/RheinSullivan/islamicIcons"
  },
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "sideEffects": false,
  "keywords": [
    "islamic",
    "icons",
    "svg",
    "webp",
    "icon-library",
    "islamic-icons",
    "muslim",
    "mosque",
    "quran",
    "ramadan",
    "prayer",
    "hajj",
    "sadaqah",
    "zakat",
    "framework-agnostic",
    "design-system",
    "ui"
  ],
  "homepage": "https://github.com/RheinSullivan/islamicIcons",
  "repository": {
    "type": "git",
    "url": "https://github.com/RheinSullivan/islamicIcons.git",
    "directory": "library"
  },
  "bugs": {
    "url": "https://github.com/RheinSullivan/islamicIcons/issues"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "metadata.js",
    "metadata.d.ts",
    "categories.js",
    "categories.d.ts",
    "icons",
    "sources",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "ATTRIBUTION.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./metadata": {
      "types": "./metadata.d.ts",
      "import": "./metadata.js"
    },
    "./categories": {
      "types": "./categories.d.ts",
      "import": "./categories.js"
    },
    "./icons/*": "./icons/*/index.js",
    "./icons/*.js": "./icons/*.js",
    "./sources/*": "./sources/*.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun run icons:catalog && bun run icons:package",
    "icons:catalog": "bun scripts/build-catalog.ts",
    "icons:package": "bun scripts/build-package.ts",
    "icons:validate": "bun scripts/validate-icons.ts",
    "icons:import:google": "bun scripts/import-google.ts",
    "typecheck": "node --check index.js && node --check metadata.js && node --check categories.js",
    "test": "node --test",
    "lint": "node --check index.js && node --check metadata.js && node --check categories.js && node scripts/validate-publish.mjs",
    "pack": "npm pack",
    "prepublishOnly": "bun run icons:catalog && bun run icons:package && bun run icons:validate && bun run build && node scripts/validate-publish.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "logo": "assets/logo-islamic-icons.svg"
}