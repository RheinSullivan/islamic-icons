{
  "name": "atsarul-mujahidin",
  "version": "0.1.0",
  "description": "Atsarul Mujahidin (آثَارُ المُجَاهِدِيْنَ) - Islamic icon library. Traces of the Mujahidin. Create something that leaves a lasting impact for the fighters.",
  "author": {
    "name": "Atsarul Mujahidin Community",
    "email": "icons@vyagra.dev",
    "url": "https://github.com/RheinSullivan/atsarul-mujahidin"
  },
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "sideEffects": false,
  "keywords": [
    "atsarul-mujahidin",
    "آثَارُ المُجَاهِدِيْنَ",
    "athar",
    "أثر",
    "islamic",
    "icons",
    "svg",
    "webp",
    "icon-library",
    "islamic-icons",
    "muslim",
    "mosque",
    "quran",
    "ramadan",
    "prayer",
    "hajj",
    "sadaqah",
    "zakat",
    "legacy",
    "impact",
    "framework-agnostic",
    "design-system",
    "ui"
  ],
  "homepage": "https://atsarul-mujahidin.vyagra.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/RheinSullivan/atsarul-mujahidin.git",
    "directory": "library"
  },
  "bugs": {
    "url": "https://github.com/RheinSullivan/atsarul-mujahidin/issues"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "metadata.js",
    "metadata.d.ts",
    "categories.js",
    "categories.d.ts",
    "fill",
    "outline",
    "color",
    "react",
    "vue",
    "svelte",
    "vanilla",
    "icons",
    "sources",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "ATTRIBUTION.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./metadata": {
      "types": "./metadata.d.ts",
      "import": "./metadata.js"
    },
    "./categories": {
      "types": "./categories.d.ts",
      "import": "./categories.js"
    },
    "./fill/*": "./fill/*.js",
    "./outline/*": "./outline/*.js",
    "./color/*": "./color/*.js",
    "./react/fill": "./react/fill/index.js",
    "./react/outline": "./react/outline/index.js",
    "./react/color": "./react/color/index.js",
    "./vue/fill": "./vue/fill/index.js",
    "./vue/outline": "./vue/outline/index.js",
    "./vue/color": "./vue/color/index.js",
    "./svelte/fill": "./svelte/fill/index.js",
    "./svelte/outline": "./svelte/outline/index.js",
    "./svelte/color": "./svelte/color/index.js",
    "./vanilla": "./vanilla/athar.js",
    "./icons/*": "./icons/*/index.js",
    "./icons/*.js": "./icons/*.js",
    "./sources/*": "./sources/*.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun run icons:catalog && bun run icons:package && bun run icons:components",
    "icons:catalog": "bun scripts/build-catalog.ts",
    "icons:package": "bun scripts/build-package.ts",
    "icons:components": "bun scripts/build-components.ts",
    "icons:validate": "bun scripts/validate-icons.ts",
    "icons:import:google": "bun scripts/import-google.ts",
    "typecheck": "node --check index.js && node --check metadata.js && node --check categories.js",
    "test": "node --test",
    "lint": "node --check index.js && node --check metadata.js && node --check categories.js && node scripts/validate-publish.mjs",
    "pack": "npm pack",
    "prepublishOnly": "bun run icons:catalog && bun run icons:package && bun run icons:components && bun run icons:validate && node scripts/validate-publish.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "logo": "assets/logo-islamic-icons.svg"
}